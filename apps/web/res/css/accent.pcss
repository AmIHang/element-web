:root,
[class*="cpd-theme-"] {
    --cpd-color-text-action-accent: var(--app-accent-900);
    --cpd-color-text-badge-accent: var(--app-accent-1100);
    --cpd-color-bg-accent-rest: var(--app-accent-900);
    --cpd-color-bg-accent-hovered: var(--app-accent-1000);
    --cpd-color-bg-accent-pressed: var(--app-accent-1100);
    --cpd-color-bg-accent-selected: var(--app-accent-alpha-300);
    --cpd-color-bg-accent-subtle: var(--app-accent-200);
    --cpd-color-bg-badge-accent: var(--app-accent-400);
    --cpd-color-border-accent-subtle: var(--app-accent-700);
    --cpd-color-border-accent-primary: var(--app-accent-900);
    --cpd-color-icon-accent-tertiary: var(--app-accent-800);
    --cpd-color-icon-accent-primary: var(--app-accent-900);
    --cpd-color-gradient-subtle-stop1: var(--app-accent-alpha-500);
    --cpd-color-gradient-subtle-stop2: var(--app-accent-alpha-400);
    --cpd-color-gradient-subtle-stop3: var(--app-accent-alpha-300);
    --cpd-color-gradient-subtle-stop4: var(--app-accent-alpha-200);
    --cpd-color-gradient-subtle-stop5: var(--app-accent-alpha-100);
}

/* The action gradient runs in opposite directions in light and dark themes */
.cpd-theme-light,
.cpd-theme-light-hc {
    --cpd-color-gradient-action-stop1: var(--app-accent-500);
    --cpd-color-gradient-action-stop2: var(--app-accent-700);
    --cpd-color-gradient-action-stop3: var(--app-accent-900);
    --cpd-color-gradient-action-stop4: var(--app-accent-1100);
}

.cpd-theme-dark,
.cpd-theme-dark-hc {
    --cpd-color-gradient-action-stop1: var(--app-accent-1100);
    --cpd-color-gradient-action-stop2: var(--app-accent-900);
    --cpd-color-gradient-action-stop3: var(--app-accent-700);
    --cpd-color-gradient-action-stop4: var(--app-accent-500);
}
