/*
 * Uses the violet of the app icon as the accent colour instead of Compound's green, or the colour the user picked
 * in the appearance settings (`data-accent` on the root element, see accentColor.ts).
 * The accent tokens point at the `--app-accent-*` scale, and that scale points at one Compound palette. Every
 * palette has the same steps, so contrast stays as designed in every theme whichever colour is picked.
 * Success colours (verified, diff additions, …) stay green on purpose: there green means "good", not "brand".
 *
 * Imported into Compound's `custom` layer, which sits above its semantic tokens but below custom themes.
 * No leading underscore, so that rethemendex.sh does not also pull it into the app-web layer.
 */

/* The accent scale has to be set wherever a theme class sets the palettes, so it picks that theme's shades */
:root,
[class*="cpd-theme-"] {
    --app-accent-100: var(--cpd-color-purple-100);
    --app-accent-200: var(--cpd-color-purple-200);
    --app-accent-300: var(--cpd-color-purple-300);
    --app-accent-400: var(--cpd-color-purple-400);
    --app-accent-500: var(--cpd-color-purple-500);
    --app-accent-600: var(--cpd-color-purple-600);
    --app-accent-700: var(--cpd-color-purple-700);
    --app-accent-800: var(--cpd-color-purple-800);
    --app-accent-900: var(--cpd-color-purple-900);
    --app-accent-1000: var(--cpd-color-purple-1000);
    --app-accent-1100: var(--cpd-color-purple-1100);
    --app-accent-1200: var(--cpd-color-purple-1200);
    --app-accent-1300: var(--cpd-color-purple-1300);
    --app-accent-1400: var(--cpd-color-purple-1400);
    --app-accent-alpha-100: var(--cpd-color-alpha-purple-100);
    --app-accent-alpha-200: var(--cpd-color-alpha-purple-200);
    --app-accent-alpha-300: var(--cpd-color-alpha-purple-300);
    --app-accent-alpha-400: var(--cpd-color-alpha-purple-400);
    --app-accent-alpha-500: var(--cpd-color-alpha-purple-500);
}

